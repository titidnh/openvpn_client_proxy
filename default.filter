###############################################################################
# default.filter — Filtres de nettoyage headers, URLs et HTML
###############################################################################

##
## FILTER: remove-proxy-headers
## Supprime les headers révélateurs dans les requêtes et réponses
##
FILTER: remove-proxy-headers Suppression headers proxy et tracking

# Headers de forwarding IP
s/^X-Forwarded-For:.*\n//im
s/^Forwarded:.*\n//im
s/^Forwarded-For:.*\n//im
s/^Client-IP:.*\n//im
s/^True-Client-IP:.*\n//im
s/^CF-Connecting-IP:.*\n//im
s/^X-Real-IP:.*\n//im
s/^Via:.*\n//im
s/^Proxy-Connection:.*\n//im

# Headers de tracing distribué (OpenTelemetry / W3C)
s/^traceparent:.*\n//im
s/^tracestate:.*\n//im
s/^baggage:.*\n//im
s/^b3:.*\n//im
s/^X-B3-TraceId:.*\n//im
s/^X-B3-SpanId:.*\n//im
s/^X-B3-ParentSpanId:.*\n//im
s/^X-B3-Sampled:.*\n//im
s/^X-Amzn-Trace-Id:.*\n//im
s/^X-Request-Id:.*\n//im

# Headers navigateur fingerprint
s/^Referer:.*\n//im
s/^Sec-CH-UA[^:]*:.*\n//img
s/^Sec-Fetch-[^:]+:.*\n//img
s/^Sec-Purpose:.*\n//im
s/^Purpose:.*\n//im
s/^Device-Memory:.*\n//im
s/^Downlink:.*\n//im
s/^RTT:.*\n//im
s/^ECT:.*\n//im
s/^Viewport-Width:.*\n//im
s/^DPR:.*\n//im
s/^Priority:.*\n//im

# Privacy Sandbox / Topics API
s/^Sec-Browsing-Topics:.*\n//im
s/^Observe-Browsing-Topics:.*\n//im
s/^Attribution-Reporting-Eligible:.*\n//im
s/^Attribution-Reporting-Support:.*\n//im

# Protected Audience API / FLEDGE (2026)
s/^Sec-Auction-Signals:.*\n//im
s/^Sec-Ad-Auction-Fetch:.*\n//im

# Topics API alternatives
s/^Sec-Topics[^:]*:.*\n//im
s/^X-Topics[^:]*:.*\n//im

# Contextual Signal Sharing (2026)
s/^Sec-Contextual-Signal:.*\n//im
s/^X-Contextual-Data:.*\n//im

# First-party CDP headers
s/^X-Customer-Data[^:]*:.*\n//im
s/^CDP-Signal:.*\n//im

# Unified ID 2.0 headers
s/^X-Uid2[^:]*:.*\n//im
s/^X-Rampid[^:]*:.*\n//im

# Consent/Preference Sync Headers
s/^X-Consent-Token:.*\n//im
s/^X-Privacy-Pref:.*\n//im
s/^X-IAB-TCF:.*\n//im

# Email & CRM Headers (2026)
s/^X-Subscriber-Id:.*\n//im
s/^X-Email-Id:.*\n//im
s/^X-Campaign-Id:.*\n//im
s/^X-List-Id:.*\n//im

# Session & Form Tracking Headers
s/^X-Session-Recording:.*\n//im
s/^X-Form-Tracking:.*\n//im
s/^X-Session-Replay:.*\n//im

# Sales Intelligence & B2B Headers (2026)\ns/^X-Account-Id:.*\n//im
s/^X-Intent-Score:.*\n//im
s/^X-Lead-Score:.*\n//im
s/^X-Buying-Signal:.*\n//im
s/^X-Firmographic:.*\n//im
s/^X-Technographic:.*\n//im

# Video Analytics Headers
s/^X-Video-Session:.*\n//im
s/^X-Playback-Data:.*\n//im
s/^X-Watch-Time:.*\n//im

# Audio/Voice Fingerprinting Headers (2026)
s/^X-Audio-Fingerprint:.*\n//im
s/^X-Voice-Id:.*\n//im
s/^X-Speech-Data:.*\n//im

# Web3/Blockchain Headers (2026)
s/^X-Wallet-Address:.*\n//im
s/^X-Blockchain-Id:.*\n//im
s/^X-Web3-User:.*\n//im


##
## FILTER: remove-js-trackers
## Supprime les scripts de tracking JavaScript courants
##
FILTER: remove-js-trackers Suppression scripts tracking JavaScript

# Google Analytics
s/<script[^>]*(?:data-)?src=["\'][^"\'>]*(?:\/analytics\.js|googletagmanager|google-analytics|ga\.js)[^"\'>]*["\'][^>]*>.*?<\/script>//igs

# Facebook/Meta tracking
s/<script[^>]*(?:data-)?src=["\'][^"\'>]*facebook\.com\/.*\/fbevents\.js[^"\'>]*["\'][^>]*>.*?<\/script>//igs

# Hotjar
s/<script[^>]*(?:data-)?src=["\'][^"\'>]*hotjar\.com[^"\'>]*["\'][^>]*>.*?<\/script>//igs

# Mixpanel
s/<script[^>]*(?:data-)?src=["\'][^"\'>]*mixpanel\.com[^"\'>]*["\'][^>]*>.*?<\/script>//igs

# Segment
s/<script[^>]*(?:data-)?src=["\'][^"\'>]*cdn\.segment\.com[^"\'>]*["\'][^>]*>.*?<\/script>//igs

##
## FILTER: anti-fingerprint
## Supprime les données de fingerprinting JavaScript
##
FILTER: anti-fingerprint Suppression données de fingerprinting

# Canvas fingerprinting
s/canvas\.toDataURL\([^)]*\)/""/igs

# WebGL fingerprinting
s/getParameter\(.*?UNMASKED_VENDOR\)/"WebGL Disabled"/igs
s/getParameter\(.*?UNMASKED_RENDERER\)/"WebGL Disabled"/igs

# Font detection
s/document\.fonts\.check\([^)]*\)/false/igs

# Plugin detection
s/navigator\.plugins/\[\]/igs
s/navigator\.mimeTypes/\[\]/igs

# WebRTC leak prevention
s/RTCPeerConnection\([^)]*\)/null/igs
s/webkitRTCPeerConnection\([^)]*\)/null/igs

# Screen resolution leaking
s/window\.screen\.width/1024/igs
s/window\.screen\.height/768/igs
s/devicePixelRatio/1/igs

##
## FILTER: strip-tracking-params
## Supprime les paramètres avancés de suivi (2026)
##
FILTER: strip-tracking-params Suppression paramètres tracking avancés 2026

# Paramètres de suivi server-side (SST)
s/[?&]server_side_tracking=[^&\s"']*//ig
s/[?&]sst_event=[^&\s"']*//ig
s/[?&]first_party_event=[^&\s"']*//ig
s/[?&]event_id=[^&\s"']*//ig
s/[?&]event_timestamp=[^&\s"']*//ig

# Cross-domain tracking IDs
s/[?&]cross_domain_id=[^&\s"']*//ig
s/[?&]extended_id=[^&\s"']*//ig
s/[?&]visitor_id=[^&\s"']*//ig
s/[?&]user_hash=[^&\s"']*//ig

# CDP/DMP identifiers
s/[?&]cdp_id=[^&\s"']*//ig
s/[?&]dmp_id=[^&\s"']*//ig
s/[?&]customer_id=[^&\s"']*//ig
s/[?&]audience_id=[^&\s"']*//ig
s/[?&]segment_id=[^&\s"']*//ig

# Privacy-invasive feature flags
s/[?&]ad_targeting=[^&\s"']*//ig
s/[?&]targeting_keywords=[^&\s"']*//ig
s/[?&]user_segments=[^&\s"']*//ig
s/[?&]behavioral_data=[^&\s"']*//ig
s/[?&]purchase_intent=[^&\s"']*//ig

# Video analytics tracking (2026)
s/[?&]video_id=[^&\s"']*//ig
s/[?&]video_session=[^&\s"']*//ig
s/[?&]watch_time=[^&\s"']*//ig
s/[?&]playback_data=[^&\s"']*//ig
s/[?&]engagement_metrics=[^&\s"']*//ig

# Form & Session Replay (Privacy invasive)
s/[?&]form_data=[^&\s"']*//ig
s/[?&]session_recording=[^&\s"']*//ig
s/[?&]replay_token=[^&\s"']*//ig
s/[?&]mouse_data=[^&\s"']*//ig

# Email & CRM tracking
s/[?&]email_id=[^&\s"']*//ig
s/[?&]subscriber_id=[^&\s"']*//ig
s/[?&]list_id=[^&\s"']*//ig
s/[?&]campaign_id=[^&\s"']*//ig
s/[?&]email_open=[^&\s"']*//ig
s/[?&]link_click=[^&\s"']*//ig
s/[?&]unsubscribe_id=[^&\s"']*//ig

# Sales & B2B Intelligence (2026)
s/[?&]account_id=[^&\s"']*//ig
s/[?&]intent_score=[^&\s"']*//ig
s/[?&]firmographic=[^&\s"']*//ig
s/[?&]technographic=[^&\s"']*//ig
s/[?&]buying_signal=[^&\s"']*//ig
s/[?&]predictive_score=[^&\s"']*//ig
s/[?&]lead_score=[^&\s"']*//ig

# Audio & Voice Fingerprinting (2026)
s/[?&]audio_fingerprint=[^&\s"']*//ig
s/[?&]voice_id=[^&\s"']*//ig
s/[?&]voice_data=[^&\s"']*//ig
s/[?&]speech_analytics=[^&\s"']*//ig

# Web3/Blockchain Tracking (2026)
s/[?&]wallet_address=[^&\s"']*//ig
s/[?&]blockchain_id=[^&\s"']*//ig
s/[?&]nft_tracking=[^&\s"']*//ig
s/[?&]defi_activity=[^&\s"']*//ig
s/[?&]web3_user=[^&\s"']*//ig

##
## FILTER: strip-utm-params
## Supprime les paramètres de tracking dans les URLs et redirections
##
FILTER: strip-utm-params Nettoyage paramètres UTM et tracking dans les URLs

# UTM Google Analytics
s/[?&]utm_source=[^&\s"']*//ig
s/[?&]utm_medium=[^&\s"']*//ig
s/[?&]utm_campaign=[^&\s"']*//ig
s/[?&]utm_term=[^&\s"']*//ig
s/[?&]utm_content=[^&\s"']*//ig
s/[?&]utm_id=[^&\s"']*//ig
s/[?&]utm_reader=[^&\s"']*//ig

# Facebook / Meta
s/[?&]fbclid=[^&\s"']*//ig
s/[?&]fb_action_ids=[^&\s"']*//ig
s/[?&]fb_action_types=[^&\s"']*//ig
s/[?&]fb_source=[^&\s"']*//ig

# Microsoft / Bing
s/[?&]msclkid=[^&\s"']*//ig

# Google Click ID
s/[?&]gclid=[^&\s"']*//ig
s/[?&]gclsrc=[^&\s"']*//ig
s/[?&]dclid=[^&\s"']*//ig
s/[?&]gbraid=[^&\s"']*//ig
s/[?&]wbraid=[^&\s"']*//ig

# Twitter / X
s/[?&]twclid=[^&\s"']*//ig

# LinkedIn
s/[?&]li_fat_id=[^&\s"']*//ig

# TikTok
s/[?&]ttclid=[^&\s"']*//ig

# Outbrain
s/[?&]obOrigUrl=[^&\s"']*//ig

# Divers
s/[?&]mc_eid=[^&\s"']*//ig
s/[?&]mc_cid=[^&\s"']*//ig

# Amazon Ads
s/[?&]amazon_ad_id=[^&\s"']*//ig
s/[?&]amzn_assoc_ad_mode=[^&\s"']*//ig

# Snap / Snapchat
s/[?&]snap_pxl=[^&\s"']*//ig
s/[?&]scm_data=[^&\s"']*//ig

# Identifiants Unifiés (RampID, UnifiedID, etc)
s/[?&]rampid=[^&\s"']*//ig
s/[?&]unified_id=[^&\s"']*//ig
s/[?&]userid=[^&\s"']*//ig
s/[?&]adid=[^&\s"']*//ig

# Paramètres de consentement et préférences
s/[?&]consent_token=[^&\s"']*//ig
s/[?&]consent_string=[^&\s"']*//ig
s/[?&]iab_tcf=[^&\s"']*//ig
s/[?&]privacy_signal=[^&\s"']*//ig

# Paramètres comportementaux (scroll, engagement, etc)
s/[?&]scroll_depth=[^&\s"']*//ig
s/[?&]engagement_time=[^&\s"']*//ig
s/[?&]time_on_page=[^&\s"']*//ig
s/[?&]mouse_movements=[^&\s"']*//ig
s/[?&]keystroke_data=[^&\s"']*//ig

# Paramètres de contextualisation IA/ML (2026)
s/[?&]ai_context=[^&\s"']*//ig
s/[?&]content_vector=[^&\s"']*//ig
s/[?&]semantic_hash=[^&\s"']*//ig
s/[?&]ml_signal=[^&\s"']*//ig

# Tracking d'apprentissage données (données d'entraînement)
s/[?&]training_data=[^&\s"']*//ig
s/[?&]data_telemetry=[^&\s"']*//ig
s/[?&]model_improvement=[^&\s"']*//ig

# Paramètres de session et device fingerprinting avancé
s/[?&]session_id=[^&\s"']*//ig
s/[?&]fp_hash=[^&\s"']*//ig
s/[?&]device_fingerprint=[^&\s"']*//ig
s/[?&]_ga=[^&\s"']*//ig
s/[?&]_gl=[^&\s"']*//ig
s/[?&]_hsenc=[^&\s"']*//ig
s/[?&]_hsmi=[^&\s"']*//ig
s/[?&]yclid=[^&\s"']*//ig
s/[?&]wickedid=[^&\s"']*//ig
s/[?&]vero_id=[^&\s"']*//ig
s/[?&]ref=[^&\s"']*//ig

# Nettoyage résiduel : ? ou & orphelin en fin d'URL
s/\?&/\?/g
s/[?&]+$//g

##
## FILTER: block-webrtc
## Neutralise les APIs WebRTC (RTCPeerConnection et variantes) pour empêcher
## la fuite de l'IP réelle via STUN/ICE, contournant le proxy/VPN.
##
## Mécanisme : injection d'un script en tête de page qui remplace les
## constructeurs WebRTC natifs par des stubs silencieux AVANT tout autre
## script de la page. Le stub implémente l'interface EventTarget pour
## éviter les erreurs JS qui casseraient les pages.
##
## Couverture :
##   - RTCPeerConnection (standard W3C)
##   - webkitRTCPeerConnection (Chrome legacy)
##   - mozRTCPeerConnection (Firefox legacy)
##   - RTCSessionDescription / RTCIceCandidate (constructeurs associés)
##
## Limitation connue : ne bloque pas les workers (SharedWorker / ServiceWorker)
## ni le WebRTC natif hors-navigateur. Pour une protection totale, combiner
## avec le blocage réseau STUN (ports UDP 3478, 5349) au niveau iptables.
##
FILTER: block-webrtc Neutralisation WebRTC pour prévenir les fuites IP

s|<head>|<head><script>(function(){var _stub=function(){var _ev={};return{createOffer:function(){return Promise.reject(new DOMException('WebRTC blocked','NotSupportedError'));},createAnswer:function(){return Promise.reject(new DOMException('WebRTC blocked','NotSupportedError'));},setLocalDescription:function(){return Promise.reject(new DOMException('WebRTC blocked','NotSupportedError'));},setRemoteDescription:function(){return Promise.reject(new DOMException('WebRTC blocked','NotSupportedError'));},addIceCandidate:function(){return Promise.reject(new DOMException('WebRTC blocked','NotSupportedError'));},close:function(){},getStats:function(){return Promise.resolve(new Map());},getSenders:function(){return[];},getReceivers:function(){return[];},addTrack:function(){},removeTrack:function(){},addEventListener:function(t,cb){(_ev[t]=_ev[t]||[]).push(cb);},removeEventListener:function(t,cb){_ev[t]=(_ev[t]||[]).filter(function(f){return f!==cb;});},dispatchEvent:function(){return true;},signalingState:'closed',iceConnectionState:'closed',iceGatheringState:'complete',connectionState:'closed',localDescription:null,remoteDescription:null,onicecandidate:null,ontrack:null,ondatachannel:null,onnegotiationneeded:null,oniceconnectionstatechange:null,onicegatheringstatechange:null,onsignalingstatechange:null,onconnectionstatechange:null};};var C=function(){return _stub();};C.prototype={};['RTCPeerConnection','webkitRTCPeerConnection','mozRTCPeerConnection'].forEach(function(k){try{Object.defineProperty(window,k,{value:C,writable:false,configurable:false});}catch(e){}});try{Object.defineProperty(window,'RTCSessionDescription',{value:function(i){return i||{};},writable:false,configurable:false});}catch(e){}try{Object.defineProperty(window,'RTCIceCandidate',{value:function(i){return i||{};},writable:false,configurable:false});}catch(e){}})();</script>|igs


##
## FILTER: strip-named-tracking-cookies
## Supprime les cookies de tracking connus par leur nom dans les headers
## Set-Cookie (réponse serveur) et Cookie (requête client)
## Couvre : Google Analytics, Meta Pixel, Microsoft Clarity,
##          Hotjar, Criteo, LinkedIn, TikTok, et divers
##
FILTER: strip-named-tracking-cookies Suppression cookies de tracking par nom

# --- Google Analytics & Ads ---
# _ga, _ga_XXXXXX, _gid, _gat, _gat_UA-XXXXX, __utma..z, _gcl_au, _gcl_aw
s/(?:^|(?<=;)\s*)_ga(?:_[A-Z0-9]+)?=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_gid=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_gat(?:_[^=]+)?=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)__utm[a-z]=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_gcl_(?:au|aw|dc|gs|gf)=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_gac_(?:[^=]+)=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)__gads=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)__gpi=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)ANID=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)IDE=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)NID=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)1P_JAR=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)CONSENT=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)SOCS=[^;,\n]*(?:;\s*)?//ig

# --- Meta / Facebook ---
# _fbp, _fbc, fr, datr, sb, wd, xs, c_user
s/(?:^|(?<=;)\s*)_fbp=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_fbc=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)fr=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)datr=[^;,\n]*(?:;\s*)?//ig

# --- Microsoft Clarity & Ads ---
# _clck, _clsk, MUID, MC1, MSFPC, MR, SRM_B
s/(?:^|(?<=;)\s*)_clck=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_clsk=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)MUID=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)MSFPC=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)MR=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)SRM_B=[^;,\n]*(?:;\s*)?//ig

# --- Hotjar ---
# _hjSessionUser_XXXXX, _hjSession_XXXXX, _hjid, _hjAbsoluteSessionInProgress
s/(?:^|(?<=;)\s*)_hj[A-Za-z_]+(?:_\d+)?=[^;,\n]*(?:;\s*)?//ig

# --- Criteo ---
# uid, optout, cto_bundle, cto_lwid
s/(?:^|(?<=;)\s*)cto_(?:bundle|lwid|optout)=[^;,\n]*(?:;\s*)?//ig

# --- LinkedIn ---
# li_gc, li_fat_id, AnalyticsSyncHistory, UserMatchHistory, bcookie, bscookie
s/(?:^|(?<=;)\s*)li_gc=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)li_fat_id=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)AnalyticsSyncHistory=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)UserMatchHistory=[^;,\n]*(?:;\s*)?//ig

# --- TikTok ---
# _ttp, tt_webid_v2
s/(?:^|(?<=;)\s*)_ttp=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)tt_webid_v2=[^;,\n]*(?:;\s*)?//ig

# --- Twitter / X ---
# _twitter_sess, eu_cn, personalization_id, guest_id_marketing
s/(?:^|(?<=;)\s*)personalization_id=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)guest_id_marketing=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)guest_id_ads=[^;,\n]*(?:;\s*)?//ig

# --- Segment ---
# ajs_user_id, ajs_anonymous_id, ajs_group_id
s/(?:^|(?<=;)\s*)ajs_(?:user|anonymous|group)_id=[^;,\n]*(?:;\s*)?//ig

# --- Amplitude ---
s/(?:^|(?<=;)\s*)amplitude_id[^=]*=[^;,\n]*(?:;\s*)?//ig

# --- Mixpanel ---
s/(?:^|(?<=;)\s*)mp_[a-f0-9]+_mixpanel=[^;,\n]*(?:;\s*)?//ig

# --- Divers trackers ---
# __cfduid (Cloudflare legacy), _pin_unauth, __hssc, __hssrc, __hstc (HubSpot)
s/(?:^|(?<=;)\s*)__cfduid=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)__hs(?:sc|src|tc)=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)hubspotutk=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_pin_unauth=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_uetsid=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_uetvid=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)_hjTLDTest=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)uuid=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)uid=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)__qca=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)__atuvc=[^;,\n]*(?:;\s*)?//ig
s/(?:^|(?<=;)\s*)__atuvs=[^;,\n]*(?:;\s*)?//ig

# Nettoyage d'un éventuel header Set-Cookie/Cookie vide après suppression
s/^Set-Cookie:\s*;\s*$/Set-Cookie: /im
s/^Cookie:\s*;\s*$/Cookie: /im
