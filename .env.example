# ===========================================================================
# .env.example - Modèle de configuration pour openvpn_client_proxy
#
# NE REMPLISSEZ PAS CE FICHIER : copiez-le en .env (ignoré par Git) et
# remplissez-y vos valeurs. Ne committez jamais de secrets.
#   cp .env.example .env
# ===========================================================================

# ============================================
# Configuration VPN
# ============================================
# Choisir le type: openvpn ou wireguard
VPN_TYPE=openvpn
OPENVPN_ENABLED=true
WIREGUARD_ENABLED=false

# ============================================
# Configuration DNS
# ============================================
DNS_SERVER_1=94.140.14.14
DNS_SERVER_2=94.140.15.15

# ============================================
# Configuration Proxy
# ============================================
PROXY_USER=
PROXY_PASS=

# ============================================
# Configuration Tailscale (optionnel)
# ============================================
ENABLE_TAILSCALE=false
TAILSCALE_AUTHKEY=

# ============================================
# Configuration NetBird (optionnel)
# ============================================
# Mesh VPN alternatif a Tailscale - la setup key est passee au client
# par son environnement (NB_SETUP_KEY), jamais sur la ligne de commande.
ENABLE_NETBIRD=false
NETBIRD_SETUP_KEY=
# Vide = cloud NetBird (https://api.netbird.io:443); auto-heberge:
# NETBIRD_MANAGEMENT_URL=https://netbird.exemple.com:443
NETBIRD_MANAGEMENT_URL=
NETBIRD_FLAGS=

# ============================================
# Configuration DNS-over-TLS (optionnel)
# ============================================
ENABLE_DOT=false
DOT_DNS_SERVERS=tls://dns.adguard-dns.com

# ============================================
# Configuration Métriques (optionnel)
# ============================================
ENABLE_METRICS=false
# Port d'écoute de l'endpoint /metrics (défaut 9100)
METRICS_PORT=9100
# Adresse d'écoute : 127.0.0.1 (défaut) = loopback conteneur uniquement
# (accès via docker exec, ou mapping "127.0.0.1:9100:9100" pour l'hôte).
# 0.0.0.0 = opt-in LAN (scrape Prometheus distant) : publiez aussi le port
# dans docker-compose - expose l'état du VPN au réseau.
METRICS_BIND=127.0.0.1
