# ===========================================================================
# .shellcheckrc - Configuration pour shellcheck
# 
# Ce fichier configure shellcheck pour ignorer certaines vérifications
# qui sont intentionnellement désactivées dans ce projet.
# 
# Auteur: Vibe Code (2026)
# Licence: MIT
# Version: 2.0.0
# ===========================================================================

# Ignorer les avertissements pour les variables non citées
# (nous utilisons beaucoup de variables d'environnement)
ignore=SC2154

# Ignorer les avertissements pour les commandes dans des sous-shells
# (nous utilisons des commandes dans des boucles et conditions)
ignore=SC2046

# Ignorer les avertissements pour les expansions de variables non citées
# (nous utilisons des tableaux et des variables dynamiques)
ignore=SC2206

# Ignorer les avertissements pour les commandes avec des variables non citées
# (nous utilisons des variables dans des commandes comme kill, nc, etc.)
ignore=SC2086

# Ignorer les avertissements pour les tests de fichiers
# (nous utilisons [ -f file ] qui est correct)
ignore=SC2166

# Ignorer les avertissements pour les boucles while read
# (nous utilisons while read -r qui est correct)
ignore=SC2162

# Ignorer les avertissements pour les expansions de variables dans les chaînes
# (nous utilisons des variables dans des chaînes de caractères)
ignore=SC2254

# Ignorer les avertissements pour les commandes avec des arguments vides
# (nous avons des vérifications pour les variables vides)
ignore=SC2115

# Ignorer les avertissements pour les commandes avec des arguments non cités
# (nous utilisons des variables dans des commandes comme sed, awk, etc.)
ignore=SC2048

# Ignorer les avertissements pour les commandes avec des variables non expansées
# (nous utilisons des variables dans des commandes comme echo, printf, etc.)
ignore=SC2181
