# ShellCheck configuration for this project
# Disable specific warnings that are intentionally used in this codebase

# SC1091: Not following sourced files (runtime paths like /usr/local/lib/)
# SC2015: A && B || C pattern (intentional, used throughout codebase)
# SC2018: Use [:lower:] to support accents (tr 'A-Z' 'a-z' is valid for domain names)
# SC2019: Use [:upper:] to support accents (tr 'A-Z' 'a-z' is valid for domain names)
# SC2034: Variable appears unused (used in other sourced modules)
# SC2154: Referenced but not assigned (env vars)
# SC2046: Quote to avoid word splitting
# SC2206: Quote to avoid word splitting in array
# SC2086: Double quote to prevent globbing
# SC2166: Prefer [ p ] && [ q ]
# SC2162: read without -r will mangle backslashes
# SC2254: Expand in double quotes
# SC2115: Argument mismatch with mv/rm
# SC2048: Word splitting in arrays
# SC2181: Check exit code directly
# SC2317: Command appears unreachable (false positive due to complex control flow)
# SC2323: Unnecessary parentheses in arithmetic (style preference)
disable=SC1091,SC2015,SC2018,SC2019,SC2034,SC2154,SC2046,SC2206,SC2086,SC2166,SC2162,SC2254,SC2115,SC2048,SC2181,SC2317,SC2323
