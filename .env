# ============================================
# Configuration VPN
# ============================================
# Choisir le type: openvpn ou wireguard
VPN_TYPE=openvpn
OPENVPN_ENABLED=true
WIREGUARD_ENABLED=false

# ============================================
# Mode Camouflage (obfuscation TLS via stunnel)
# Comme le mode Camouflage de l app Surfshark : le tunnel OpenVPN
# est encapsule dans du TLS sur le port 443, indifferenciable du HTTPS.
# ATTENTION : le serveur doit TERMINER le TLS sur CAMOUFLAGE_PORT. Les serveurs
# OpenVPN/TCP standard (CyberGhost, .ovpn Surfshark) parlent OpenVPN en clair sur
# 443 : le camouflage y est impossible (sonde TLS -> repli, cf. README).
# ============================================
ENABLE_CAMOUFLAGE=false
CAMOUFLAGE_PORT=443
CAMOUFLAGE_LOCAL_PORT=1194
CAMOUFLAGE_TLS_VERIFY=true
# Si aucun serveur ne repond en TLS sur CAMOUFLAGE_PORT : true = repli sur OpenVPN
# classique (non obfusque, WARN dans les logs), false = echec explicite.
CAMOUFLAGE_FALLBACK=true

# ============================================
# Configuration DNS
# ============================================
DNS_SERVER_1=94.140.14.14
DNS_SERVER_2=94.140.15.15

# ============================================
# Configuration Proxy
# ============================================
PROXY_USER=
PROXY_PASS=

# ============================================
# Configuration Tailscale (optionnel)
# ============================================
ENABLE_TAILSCALE=false
TAILSCALE_AUTHKEY=

# ============================================
# Configuration DNS-over-TLS (optionnel)
# ============================================
ENABLE_DOT=false
DOT_DNS_SERVERS=tls://dns.adguard-dns.com

# ============================================
# Configuration Métriques (optionnel)
# ============================================
ENABLE_METRICS=false
