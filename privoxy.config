###############################################################################
# privoxy.config - Configuration principale de Privoxy
# 
# Ce fichier configure Privoxy comme proxy HTTP avec des paramètres optimisés
# pour la confidentialité et la sécurité.
# 
# Auteur: Vibe Code (amélioration 2026)
# Licence: MIT
# Version: 2.0.0
# 
# Documentation: https://www.privoxy.org/user-manual/config.html
###############################################################################

# ===========================================================================
# PARAMÈTRES DE BASE
# ===========================================================================

# Port d'écoute - sera écrasé par start.sh si PROXY_USER/PROXY_PASS sont définis
listen-address 0.0.0.0:3128

# Répertoire des logs - désactivé pour Docker (confidentialité + réduction des I/O)
logdir /dev/null
logfile /dev/null

# Fichiers d'actions (ordre : default < user, user écrase default)
actionsfile /etc/privoxy/default.action
actionsfile /etc/privoxy/user.action

# Fichiers de filtres
filterfile /etc/privoxy/default.filter
filterfile /etc/privoxy/user.filter

# Pas d'interface d'administration exposée
toggle 1
enable-remote-toggle 0
enable-remote-http-toggle 0
enable-edit-actions 0

# Taille du buffer pour la compression (nécessaire pour que les filtres regex fonctionnent)
buffer-limit 10240

# ===========================================================================
# CONFIGURATIONS AVANCÉES DE SÉCURITÉ & PRIVACY (2026)
# ===========================================================================

# Timeout par défaut pour les connexions serveurs (en secondes)
default-server-timeout 60

# Refuser les connexions non-HTTPS potentiellement malveillantes
# (décommentez pour bloquer tout le trafic HTTP non sécurisé)
# enforce-blocks 1

# Options supplémentaires pour une confidentialité maximale :
# Activer pour bloquer les WebSockets (vecteur de tracking alternatif)
# websocket 0

# ===========================================================================
# PARAMÈTRES DE PERFORMANCE
# ===========================================================================

# Nombre maximum de connexions simultanées
max-client-connections 128

# Taille maximale des requêtes (en Ko)
max-request-length 8192

# Taille maximale des en-têtes (en Ko)
max-header-length 16384

# ===========================================================================
# PARAMÈTRES DE CACHE (DÉSACTIVÉ PAR DÉFAUT POUR LA CONFIDENTIALITÉ)
# ===========================================================================

# Le cache peut améliorer les performances mais peut poser des problèmes de confidentialité
# car il stocke les réponses des sites visités.
# 
# Pour activer le cache, décommentez les lignes suivantes :
# cache-dir /tmp/privoxy-cache
# cache-max-size 100
# cache-max-file-size 5

# ===========================================================================
# PARAMÈTRES DE FILTRAGE
# ===========================================================================

# Activer le filtrage des en-têtes HTTP
# (déjà activé dans les fichiers d'actions)

# ===========================================================================
# PARAMÈTRES DE CONNEXION
# ===========================================================================

# Timeout de connexion (secondes)
connect-timeout 5

# Timeout de lecture (secondes)
read-timeout 30

# Timeout d'écriture (secondes)
write-timeout 30

# ===========================================================================
# PARAMÈTRES DE SÉCURITÉ SUPPLÉMENTAIRES
# ===========================================================================

# Bloquer les requêtes CONNECT (utilisées pour HTTPS via proxy)
# Note: Cela peut casser certains sites, décommentez avec prudence
# allow-connect-to-anywhere 0

# Autoriser uniquement les requêtes vers des ports spécifiques
# (décommentez et modifiez selon vos besoins)
# permit-access 192.168.0.0/16 10.0.0.0/8 127.0.0.1

# ===========================================================================
# PARAMÈTRES DE LOG (OPTIONNEL POUR LE DÉBOGAGE)
# ===========================================================================

# Pour activer les logs d'accès chiffrés pour le diagnostic :
# 1. Créez le répertoire : docker exec <container> mkdir -p /var/log/privoxy
# 2. Décommentez les lignes suivantes :
# logdir /var/log/privoxy
# logfile /var/log/privoxy/access.log
# log-time-format %T
# log-file-time-format %Y-%m-%d %H:%M:%S

# ===========================================================================
# FIN DU FICHIER
# ===========================================================================
